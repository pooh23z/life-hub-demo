{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/send-line?type=all",
      "schedule": "20 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
